{
  "name": "polskie-vscode-plugin",
  "version": "1.0.60",
  "displayName": "Polskie Dev Tools: Read-only File Toggle",
  "publisher": "PolskieDev",
  "description": "Toggle/Untoggle Read-only attribute on files",
  "icon": "images/icon.png",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "polskieDevTools.getActiveFilePath",
        "title": "Get Active File Path"
      },
      {
        "command": "polskieDevTools.tagAsReadOnly",
        "title": "Tag as Read-only"
      },
      {
        "command": "polskieDevTools.untagAsReadOnly",
        "title": "Untag as Read-only"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "polskieDevTools.tagAsReadOnly",
          "when": "isFile && !isReadOnly",
          "group": "navigation"
        },
        {
          "command": "polskieDevTools.untagAsReadOnly",
          "when": "isFile && isReadOnly",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "polskieDevTools.tagAsReadOnly",
          "when": "isFile && !isReadOnly",
          "group": "navigation"
        },
        {
          "command": "polskieDevTools.untagAsReadOnly",
          "when": "isFile && isReadOnly",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "compile": "tsc",
    "vscode:prepublish": "npm run compile",
    "package": "sh ./package-extension.sh patch",
    "package:major": "sh ./package-extension.sh major",
    "package:minor": "sh ./package-extension.sh minor"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/polskiedev/polskie-vscode-plugin.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/polskiedev/polskie-vscode-plugin/issues"
  },
  "homepage": "https://github.com/polskiedev/polskie-vscode-plugin#readme",
  "devDependencies": {
    "@types/node": "^14.18.63",
    "typescript": "^4.0.0",
    "vscode": "^1.1.37"
  }
}
